{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teng-i.local/schemas/research-evidence/research-evidence-manifest.v1.json",
  "title": "Research Evidence Manifest v1",
  "description": "科研复盘资产索引。用于登记源媒体、侧车、标定、名册、模型与历史运行结果的版本身份和只读核验状态。本契约只表达身份与核验事实，不表达模型质量结论；算法 verdict 原样照录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "generated_at",
    "baseline",
    "assets",
    "run_refs",
    "checks",
    "completeness",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "pb.research-evidence-manifest.v1.0" },
    "package_id": {
      "type": "string",
      "pattern": "^pkg_[0-9a-f]{12}$",
      "description": "索引包标识，由基线 commit 与内容摘要派生，不随输出目录变化。"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "run_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/run_ref" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "completeness": {
      "enum": ["complete", "partial"],
      "description": "complete 仅当所有 requirement=required 的资产 availability=present 且 verification=verified，且不存在 block_completeness=true 的 limitation。该聚合判定由 CLI 执行，Schema 只约束不可自相矛盾的组合。"
    },
    "limitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/limitation" }
    }
  },
  "allOf": [
    {
      "$comment": "complete 与阻断性 limitation 不可共存。",
      "if": { "properties": { "completeness": { "const": "complete" } }, "required": ["completeness"] },
      "then": {
        "properties": {
          "limitations": {
            "items": {
              "properties": { "block_completeness": { "const": false } },
              "required": ["block_completeness"]
            }
          }
        }
      }
    },
    {
      "$comment": "asset_id 与 run_ref.run_id 在包内唯一，由 CLI 校验；Schema 约束引用形态。",
      "if": { "properties": { "completeness": { "const": "complete" } }, "required": ["completeness"] },
      "then": {
        "properties": {
          "assets": {
            "items": {
              "if": { "properties": { "requirement": { "const": "required" } }, "required": ["requirement"] },
              "then": {
                "properties": {
                  "availability": { "const": "present" },
                  "verification": { "const": "verified" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "description": "内容摘要的显式在场表达。unknown 必须与 sha256=null 同时出现，禁止用空串或占位值冒充已知。",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["known", "unknown"] },
        "sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "reason": {
          "type": ["string", "null"],
          "description": "status=unknown 时的来源说明，例如历史产物未记录摘要。"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "known" } }, "required": ["status"] },
          "then": {
            "required": ["sha256"],
            "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "unknown" } }, "required": ["status"] },
          "then": {
            "properties": {
              "sha256": { "type": "null" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["sha256", "reason"]
          }
        }
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "description": "代码身份。历史外部产物可能完全未记录版本，此时 status=unknown 且 commit=null，禁止用当前 HEAD 回填。",
      "required": ["label", "status", "commit", "worktree_clean", "dirty_patch"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "该 revision 在证据链中的角色，例如 selected_baseline、audit_snapshot、feature_line、runtime。"
        },
        "status": { "enum": ["known", "unknown"] },
        "commit": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            { "type": "null" }
          ]
        },
        "worktree_clean": {
          "type": ["boolean", "null"],
          "description": "null 表示未记录该信息，不等同于 clean。"
        },
        "dirty_patch": { "$ref": "#/$defs/digest" },
        "note": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "known" } }, "required": ["status"] },
          "then": {
            "required": ["commit"],
            "properties": { "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "unknown" } }, "required": ["status"] },
          "then": {
            "required": ["commit"],
            "properties": { "commit": { "type": "null" } }
          }
        }
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_revision", "reference_revisions"],
      "properties": {
        "selected_revision": {
          "$ref": "#/$defs/revision",
          "description": "科研候选基线。只允许一个，避免同一包内出现两个可宣称的主基线。"
        },
        "reference_revisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/revision" },
          "description": "历史对照身份，例如已保留的审计快照与功能线来源；仅作对照，不构成候选基线。"
        }
      },
      "allOf": [
        {
          "$comment": "候选基线必须可定位到具体提交。",
          "properties": {
            "selected_revision": {
              "properties": { "status": { "const": "known" } },
              "required": ["status"]
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_root_id", "source_kind"],
      "properties": {
        "source_root_id": {
          "type": "string",
          "pattern": "^root_[a-z0-9_]+$",
          "description": "授权来源根的逻辑标识。绝对路径只保存在 locations.local.json，不进入可分享 manifest。"
        },
        "source_kind": {
          "enum": ["repository", "external_disk", "windows_machine", "derived"],
          "description": "资产原始所在环境类别，用于区分可复核位置与需人工取回的位置。"
        },
        "originated_at": { "type": ["string", "null"], "format": "date-time" },
        "note": { "type": ["string", "null"] }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "kind",
        "usage_kind",
        "requirement",
        "locator",
        "size_bytes",
        "digest",
        "availability",
        "verification",
        "provenance"
      ],
      "properties": {
        "asset_id": { "type": "string", "pattern": "^a_[a-z0-9_]+$" },
        "kind": {
          "enum": [
            "source_video",
            "pts_sidecar",
            "sync_manifest",
            "calibration",
            "roster",
            "model_weight",
            "model_config",
            "model_package",
            "job_artifact",
            "annotation",
            "other"
          ]
        },
        "usage_kind": {
          "enum": ["real", "fixture", "unknown"],
          "description": "用途类型。工具不得仅凭扩展名或目录位置自动认证 real；无法确认时必须为 unknown。"
        },
        "requirement": {
          "enum": ["required", "optional"],
          "description": "相对包用途的必需性。complete 判定只聚合 required 资产。"
        },
        "locator": {
          "type": "string",
          "pattern": "^asset://[a-z0-9_]+/.+$",
          "description": "可分享的逻辑定位串，形如 asset://root_captures/2026-07-20/take_x/174_merged.mp4。路径不是 ID。"
        },
        "size_bytes": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "digest": { "$ref": "#/$defs/digest" },
        "availability": {
          "enum": ["present", "missing", "unreachable", "not_checked"],
          "description": "物理可达性。与 verification 正交：文件在但摘要不符属于 present+mismatch。"
        },
        "verification": {
          "enum": ["verified", "mismatch", "not_checked", "unknown"],
          "description": "内容核验结论。与 availability 正交：不可达是 unreachable+not_checked，不是 mismatch。"
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "media_metadata": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "duration_seconds": { "type": ["number", "null"] },
                "width": { "type": ["integer", "null"] },
                "height": { "type": ["integer", "null"] },
                "fps_nominal": { "type": ["number", "null"] },
                "frame_count": { "type": ["integer", "null"] },
                "probe_status": { "enum": ["ok", "timeout", "error", "skipped"] }
              },
              "required": ["probe_status"]
            },
            { "type": "null" }
          ]
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "run_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "origin",
        "code_revision",
        "consumes",
        "range",
        "algorithm_verdict"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^(job-[0-9a-f]{10}|run_[a-z0-9_]+)$"
        },
        "origin": {
          "enum": ["product_job", "research_cli", "external"],
          "description": "该运行的产生方式。external 用于 Windows 等外部环境产物，缺失字段按 unknown 记录，不用当前 HEAD 补齐。"
        },
        "code_revision": { "$ref": "#/$defs/revision" },
        "consumes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^a_[a-z0-9_]+$" },
          "description": "本次运行消费的 asset_id 列表，必须能在 assets 中解析。"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_seconds", "end_seconds", "time_base"],
          "properties": {
            "start_seconds": { "type": "number", "minimum": 0 },
            "end_seconds": { "type": "number", "minimum": 0 },
            "frame_start": { "type": ["integer", "null"], "minimum": 0 },
            "frame_end": { "type": ["integer", "null"], "minimum": 0 },
            "time_base": {
              "enum": ["cfr_nominal", "pts_actual", "take_unified"],
              "description": "时间基准来源。名义 fps 不能替代实际 PTS。"
            }
          }
        },
        "algorithm_verdict": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "scope", "recorded_source"],
          "properties": {
            "result": { "enum": ["pass", "fail", "not_run", "unknown"] },
            "scope": {
              "type": "string",
              "minLength": 1,
              "description": "该判定的实际作用范围，例如 30-587.15s strict four-player。"
            },
            "recorded_source": {
              "enum": ["original_job", "quality_report", "manual_review", "none"],
              "description": "原质量结论的来源。none 表示从未评估，不得当作 pass。"
            },
            "detail": { "type": ["string", "null"] }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "target_asset_id", "kind", "status", "scope"],
      "properties": {
        "check_id": { "type": "string", "pattern": "^c_[a-z0-9_]+$" },
        "target_asset_id": { "type": "string", "pattern": "^a_[a-z0-9_]+$" },
        "kind": {
          "enum": ["existence", "metadata_probe", "digest", "decode"],
          "description": "存在性、元数据探测、内容摘要与全解码分别记录，元数据成功不得升级为全解码成功。"
        },
        "status": { "enum": ["passed", "failed", "skipped", "unknown"] },
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "检查实际覆盖范围与限制，例如前 300 帧或探测 15 秒超时。"
        },
        "detail": { "type": ["string", "null"] }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "block_completeness"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "机器可读的限制码，例如 windows_job_evidence_missing。"
        },
        "message": { "type": "string", "minLength": 1 },
        "block_completeness": {
          "type": "boolean",
          "description": "true 表示该限制使包无法声明 complete。"
        },
        "affects": {
          "type": "array",
          "items": { "type": "string", "pattern": "^a_[a-z0-9_]+$" }
        },
        "notion_task": {
          "type": ["string", "null"],
          "description": "对应的外部跟踪编号，例如 PB-004。"
        }
      }
    }
  }
}
