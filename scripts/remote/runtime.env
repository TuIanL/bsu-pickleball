# 远端正式分析运行时开关。
# 无卡阶段只部署，不创建任务；切到有卡模式后由 serve.sh 自动加载本文件。

# 推理设备与队列
PICKLEBALL_ENABLE_MODEL_INFERENCE=true
PICKLEBALL_ENABLE_POSE_INFERENCE=true
PICKLEBALL_ENABLE_GPU_JOBS=true
PICKLEBALL_MAX_GPU_JOBS=1
PICKLEBALL_ANALYSIS_WORKER_MODE=external
PICKLEBALL_REMOTE_WORKER_COUNT=6
PICKLEBALL_DETECTOR_DEVICE=cuda:0
PICKLEBALL_RTMPOSE_DEVICE=cuda:0
PICKLEBALL_COURT_LINE_DEVICE=cuda:0
PICKLEBALL_MATCH_STATE_SEGMENTATION_DEVICE=cuda:0

# 正式比赛切分、回合上下文与四人身份分析
PICKLEBALL_MATCH_STATE_SEGMENTATION_ENABLED=true
PICKLEBALL_RALLY_CONTEXT_ENABLED=true
PICKLEBALL_FOUR_PLAYER_APPEARANCE_MODE=enabled
PICKLEBALL_PLAYER_LOCK_ENABLE_APPEARANCE_SCORE=true

# 球检测、轨迹/落点重建及语义回合策略
PICKLEBALL_ENABLE_BALL_DETECTION=true
PICKLEBALL_BALL_ANALYSIS_STRICT=true
PICKLEBALL_ENABLE_BOUNCE_DETECTION=true
PICKLEBALL_ENABLE_BALL_RECONSTRUCTION=true
PICKLEBALL_ENABLE_HYBRID_BALL_TRAJECTORY=true
PICKLEBALL_ENABLE_BALL_SEMANTIC_POLICY=true
PICKLEBALL_BALL_SEMANTIC_POLICY_MODE=enforced
PICKLEBALL_BALL_SEMANTIC_ENFORCED_ROLLOUT=true
PICKLEBALL_BALL_SEMANTIC_TIMELINE_ENABLED=true
PICKLEBALL_BALL_SEMANTIC_BOUNDARY_EVAL_ENABLED=true

# 全量可视化与诊断产物
PICKLEBALL_ENABLE_ANALYSIS_OVERLAY_VIDEO=true
PICKLEBALL_OVERLAY_FRAME_STRIDE=1
PICKLEBALL_ENABLE_POSITION_VISUALIZATIONS=true
PICKLEBALL_ENABLE_PROJECTION_DEBUG_JSONL=true
PICKLEBALL_ENABLE_PROJECTION_DEBUG_OVERLAY=true
PICKLEBALL_ENABLE_COURT_VIEW_GATE=true
PICKLEBALL_ENABLE_DETECTION_ROI_FILTER=true
PICKLEBALL_KITCHEN_ARRIVAL_ENABLED=true
PICKLEBALL_KITCHEN_ARRIVAL_CARD_ENABLED=true
