# 远程算力服务器连接配置模板
#
# 用法：复制本文件为 remote.env 并填入真实值。
#   cp scripts/remote/remote.env.example scripts/remote/remote.env
#
# remote.env 已在 scripts/remote/.gitignore 中忽略，不会入库——实例地址、
# 端口与用户名属于环境相关信息，不要提交。
#
# 认证方式：专用 SSH 密钥（无密码登录），任何情况下都不要在本文件保存口令或私钥内容。
#
# 远端布局（AutoDL 实例，路径按实例实际挂载调整）：
#   <REMOTE_ROOT>   项目根（代码 + models + backend/data），需放数据盘
#   <REMOTE_ENV>    Python 运行环境
#   <REMOTE_LOGS>   运行与服务日志
#
# 注意：数据盘通常 50G、系统盘只有 30G，不要把大文件写进系统盘。

REMOTE_HOST="<你的实例连接地址>"
REMOTE_PORT="<你的实例 SSH 端口>"
REMOTE_USER="root"
REMOTE_KEY="${HOME}/.ssh/<你的专用私钥文件名>"

REMOTE_ROOT="/root/autodl-tmp/pre-pickleball"
REMOTE_ENV="/root/autodl-tmp/envs/pickleball"
REMOTE_LOGS="/root/autodl-tmp/logs"

# 远程后端在服务器上监听的端口（仅回环，不暴露公网）
REMOTE_API_PORT="8000"

# 本地通过 SSH 隧道访问远程 API 时使用的端口
LOCAL_API_PORT="8100"
